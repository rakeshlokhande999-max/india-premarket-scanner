# Copy to .env and adjust. Nothing here is required to run the MVP scan --
# every value has a working default. Add real keys only when you plug in
# a paid/broker data source later.

# SQLite file for the prediction/backtest store.
SCANNER_DB_PATH=./data/scanner.db

# Root log level: DEBUG, INFO, WARNING, ERROR.
SCANNER_LOG_LEVEL=INFO

# HTTP timeout (seconds) for all outbound requests (NSE, RSS, yfinance).
SCANNER_HTTP_TIMEOUT=12

# Cap on how many Nifty-50 names get full technical+news scoring per run.
# Keep at 50 (the full list) unless you're rate-limit constrained.
SCANNER_UNIVERSE_LIMIT=50

# --- AI Momentum / Upper-Circuit Scanner (momentum.py / app-info.md) ---
# How many names (from the broad universe, pre-filtered by daily
# turnover+momentum) get the expensive per-symbol NSE live-quote +
# intraday-bar pass on "Run Market Research". NSE's quote-equity endpoint
# is undocumented and per-symbol -- raise this only if you've confirmed it
# isn't getting blocked (see README "Known limitations").
SCANNER_MOMENTUM_UNIVERSE_LIMIT=60

# Delay (seconds) between successive NSE live-quote calls in that pass --
# a courtesy throttle, not a workaround for rate limiting.
SCANNER_NSE_QUOTE_DELAY_SEC=0.15

# --- Optional upgrade points (unused by the MVP, wired for later) ---
# A broker API (Kite Connect / Upstox / Angel One SmartAPI) for true
# real-time quotes and pre-open order-book depth instead of yfinance's
# ~15-min-delayed data and NSE's public pre-open snapshot.
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCESS_TOKEN=

# A paid news/sentiment API, if RSS + keyword scoring proves too coarse.
NEWS_API_KEY=
